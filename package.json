{
  "name": "documentation-template-nextjs",
  "version": "0.1.0",
  "private": true,
  "author": "Sanjay Rajeev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sanjayc208/pinexio/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:content": "contentlayer2 build",
    "format": "prettier --write .",
    "prepare": "husky",
    "ui:install": "shadcn add accordion alert alert-dialog aspect-ratio avatar badge breadcrumb button calendar card carousel checkbox collapsible command context-menu dialog drawer dropdown-menu form hover-card input input-otp label menubar navigation-menu pagination popover progress radio-group resizable scroll-area select separator sheet sidebar skeleton slider sonner switch table tabs textarea toggle toggle-group tooltip chart --yes"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md, mdx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "nextjs",
    "documentation",
    "template",
    "docs",
    "nextjs-template",
    "static-site",
    "mdx",
    "documentation-template",
    "nextjs-docs",
    "nextjs-starter"
  ],
